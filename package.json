{
  "name": "universal-website-performance-optimizer",
  "version": "1.0.0",
  "description": "Universal browser extension that intelligently reduces website resource consumption on low-end devices with 100% local-first privacy.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "compile": "tsc --noEmit",
